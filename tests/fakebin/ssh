"""Fake `ssh` for tests: runs the remote command locally, in NG_FAKE_SERVER.

Targets containing "refuse" fail like a server that wants a password.
"""
import os, subprocess, sys
a = sys.argv[1:]; i = 0; target = None
while i < len(a):
    x = a[i]
    if x in ('-o', '-p', '-S', '-l', '-i', '-F', '-J', '-E', '-c', '-m'): i += 2; continue
    if x.startswith('-'): i += 1; continue
    target = x; i += 1; break
cmd = ' '.join(a[i:])
if target and 'refuse' in target:
    sys.stderr.write(f'{target}: Permission denied (publickey,password).\n'); sys.exit(255)
home = os.environ.get('NG_FAKE_SERVER', '/tmp/ng-fakeserver')
os.makedirs(home, exist_ok=True)
if not cmd: sys.exit(0)
sys.exit(subprocess.call(['sh', '-c', cmd], cwd=home, env={**os.environ, 'HOME': home}))
